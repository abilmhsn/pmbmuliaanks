# Backend internal address for Next.js API rewrites (default: http://localhost:5000)
BACKEND_INTERNAL_URL="http://localhost:5000"

# Optional public backend URL if bypassing rewrite proxy
NEXT_PUBLIC_API_URL=""

# Optional Supabase storage public bucket URL for documents
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://[PROJECT_REF].supabase.co/storage/v1/object/public/pmb-documents"
